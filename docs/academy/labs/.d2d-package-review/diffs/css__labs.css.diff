--- CURRENT/css/labs.css
+++ PACKAGE/css/labs.css
@@ -1215,3 +1215,71 @@
   padding: 0.75rem;
   border-radius: 10px;
 }
+
+
+/* D2-C Findings workspace */
+.pt-workspace { margin-top: 1.25rem; }
+.pt-findings { border: 1px solid rgba(0,0,0,.12); border-radius: 10px; padding: 1rem; background: #fafbfc; }
+.pt-finding-form, .pt-risk-panel, .pt-priority-panel, .pt-rem-panel, .pt-findings-summary { margin-top: .75rem; }
+.pt-label { display:block; margin-top:.5rem; font-weight:600; font-size:.9rem; }
+.pt-input { width:100%; max-width:100%; margin:.25rem 0 .5rem; padding:.45rem .6rem; border:1px solid #cbd5e1; border-radius:6px; box-sizing:border-box; }
+.pt-evidence-checks { display:flex; flex-wrap:wrap; gap:.4rem .9rem; margin:.35rem 0 .6rem; }
+.pt-check { font-family: ui-monospace, monospace; font-size:.85rem; }
+.pt-feedback { margin-top:.6rem; padding:.5rem .7rem; border-radius:6px; font-size:.9rem; }
+.pt-feedback.pt-ok { background:#ecfdf5; color:#065f46; }
+.pt-feedback.pt-bad { background:#fef2f2; color:#991b1b; }
+.pt-finding-row { border:1px solid #e2e8f0; border-radius:8px; padding:.55rem .7rem; margin:.4rem 0; background:#fff; }
+.pt-status-evidence-backed { border-color:#86efac; }
+.pt-status-needs-evidence, .pt-status-rejected { border-color:#fca5a5; }
+.pt-score-box { background:#f1f5f9; padding:.6rem .8rem; border-radius:8px; margin:.4rem 0; }
+.pt-warn { color:#b45309; }
+.pt-btn-small { margin-top:.35rem; }
+.pt-risk-row, .pt-rem-row { display:flex; flex-direction:column; gap:.35rem; margin:.5rem 0; padding:.5rem; border:1px dashed #cbd5e1; border-radius:8px; }
+.pt-reasons { color:#9f1239; font-size:.85rem; }
+@media (max-width: 720px) {
+  .pt-layout { flex-direction: column; }
+}
+
+/* D2-C compatibility with D2-B terminal selectors */
+.lab-pt .pt-term-log,
+.lab-pt .pt-terminal {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  direction: ltr;
+  text-align: left;
+  background: #0f172a;
+  color: #e2e8f0;
+  min-height: 220px;
+  max-height: 360px;
+  overflow: auto;
+  padding: .75rem;
+  border-radius: 8px;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+.lab-pt .pt-scope-panel { margin-top: .75rem; }
+.lab-pt .pt-scope-list { list-style: disc; padding-inline-start: 1.2rem; font-size: .85rem; }
+.lab-pt .pt-btn-reset { margin-top: .75rem; width: 100%; background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
+
+.lab-pt .pt-roe-panel {
+  margin: .75rem 0 1rem;
+  padding: .85rem 1rem;
+  border: 1px solid #cbd5e1;
+  border-radius: 10px;
+  background: #f8fafc;
+}
+.lab-pt .pt-roe-title { margin: 0 0 .5rem; font-size: 1rem; }
+.lab-pt .pt-roe-text { font-size: .9rem; margin-bottom: .65rem; }
+.lab-pt .pt-roe-text p { margin: .25rem 0; }
+.lab-pt .pt-roe-accept:disabled {
+  opacity: .75;
+  cursor: default;
+}
+
+/* D2-D completion panels */
+.pt-completion { margin-top: 1.25rem; border: 1px solid rgba(0,0,0,.12); border-radius: 10px; padding: 1rem; background: #f7f9fc; }
+.pt-report-panel, .pt-knowledge-panel, .pt-final-panel { margin-top: .85rem; }
+.pt-report-field { margin-bottom: .6rem; }
+.pt-report-field label, .pt-know-prompt { display: block; font-weight: 600; margin-bottom: .25rem; }
+.pt-know-q { margin-bottom: .65rem; }
+.pt-final-score { margin: .5rem 0; font-weight: 600; }
+.pt-muted { opacity: .85; font-size: .92rem; }
