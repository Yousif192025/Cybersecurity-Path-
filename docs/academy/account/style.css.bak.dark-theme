* {
    box-sizing: border-box;
}

html {
    direction: rtl;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Tahoma, Arial, sans-serif;
    background: #f3f6fb;
    color: #17243a;
    display: grid;
    place-items: center;
    padding: 24px;
}

main {
    width: min(100%, 460px);
    background: #fff;
    border: 1px solid #e1e8f0;
    border-radius: 18px;
    padding: 32px;
    box-shadow: 0 12px 38px #14213d12;
}

.brand {
    font-size: 14px;
    color: #42658a;
    margin-bottom: 16px;
    direction: ltr;
    text-align: right;
}

h1 {
    font-size: 27px;
    line-height: 1.5;
    margin: 0 0 12px;
}

p {
    line-height: 1.9;
    color: #64748b;
    margin: 0 0 18px;
}

label {
    display: block;
    margin: 20px 0 9px;
    font-size: 14px;
    font-weight: bold;
}

input {
    display: block;
    width: 100%;
    min-height: 48px;
    padding: 13px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    background: #fff;
    font: inherit;
    direction: rtl;
    text-align: right;
}

input:focus {
    outline: 2px solid #8bbce3;
    outline-offset: 2px;
    border-color: #174b78;
}

button,
.link {
    display: block;
    width: 100%;
    min-height: 48px;
    padding: 13px;
    border-radius: 9px;
    text-align: center;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
}

button {
    border: 0;
    background: #174b78;
    color: #fff;
    margin-top: 24px;
}

button:disabled {
    opacity: .6;
    cursor: wait;
}

.secondary {
    background: #fff;
    color: #174b78;
    border: 1px solid #174b78;
    margin-top: 12px;
}

.link {
    margin-top: 14px;
    color: #174b78;
}

#message {
    min-height: 24px;
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.7;
}

#message[data-state="error"] {
    color: #b42318;
}

#message[data-state="success"] {
    color: #18794e;
}

hr {
    border: 0;
    border-top: 1px solid #e2e8f0;
    margin: 24px 0;
}

@media (max-width: 480px) {
    body {
        padding: 14px;
    }

    main {
        padding: 24px 20px;
    }

    h1 {
        font-size: 24px;
    }
}
