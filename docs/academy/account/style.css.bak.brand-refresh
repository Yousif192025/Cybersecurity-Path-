* {
    box-sizing: border-box;
}

:root {
    color-scheme: dark;
    --bg: #07111f;
    --panel: rgba(15, 31, 51, .88);
    --cyan: #39d9f2;
    --cyan-soft: #8cecff;
    --text: #edf8ff;
    --muted: #a3b8cc;
    --border: rgba(111, 205, 235, .2);
}

html {
    direction: rtl;
    min-height: 100%;
    background: var(--bg);
}

body {
    position: relative;
    isolation: isolate;
    margin: 0;
    min-height: 100vh;
    padding: 36px 18px;
    display: grid;
    place-items: center;
    overflow-x: hidden;
    font-family: Tahoma, Arial, sans-serif;
    color: var(--text);
    background:
        radial-gradient(ellipse at 15% 15%, rgba(0, 190, 230, .17), transparent 38%),
        radial-gradient(ellipse at 85% 85%, rgba(25, 91, 180, .2), transparent 40%),
        linear-gradient(145deg, #050d19, #0a1b30 55%, #07111f);
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: .22;
    background-image:
        linear-gradient(rgba(75, 190, 225, .08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(75, 190, 225, .08) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
}

main {
    position: relative;
    width: min(100%, 490px);
    padding: 38px;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(20, 43, 67, .96), rgba(9, 24, 42, .96));
    border: 1px solid var(--border);
    border-radius: 24px;
    box-shadow:
        0 28px 80px rgba(0, 0, 0, .42),
        0 0 38px rgba(36, 196, 232, .08),
        inset 0 1px rgba(255, 255, 255, .06);
    backdrop-filter: blur(18px);
}

main::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--cyan), #3987ff, transparent);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 28px;
    color: var(--cyan-soft);
    font-size: 14px;
    font-weight: bold;
    letter-spacing: .5px;
    direction: ltr;
}

.brand::before {
    content: "◆";
    color: var(--cyan);
    font-size: 18px;
    text-shadow: 0 0 15px rgba(57, 217, 242, .8);
}

h1 {
    margin: 0 0 13px;
    color: #fff;
    font-size: clamp(25px, 5vw, 31px);
    line-height: 1.5;
    font-weight: 800;
}

p {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 2;
}

form {
    display: block;
    margin-top: 25px;
}

label {
    display: block;
    margin: 19px 0 9px;
    color: #d8eafa;
    font-size: 14px;
    font-weight: bold;
}

input {
    display: block;
    width: 100%;
    min-height: 51px;
    padding: 13px 15px;
    border: 1px solid rgba(147, 184, 211, .25);
    border-radius: 11px;
    outline: none;
    background: rgba(3, 14, 27, .72);
    color: #fff;
    font: inherit;
    direction: rtl;
    text-align: right;
    transition: border-color .2s, box-shadow .2s, background .2s;
}

input::placeholder {
    color: #7890a8;
}

input:focus {
    border-color: var(--cyan);
    background: rgba(5, 22, 39, .95);
    box-shadow: 0 0 0 3px rgba(57, 217, 242, .12);
}

button,
.link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 50px;
    padding: 13px 16px;
    border-radius: 11px;
    font: inherit;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform .2s, background .2s, box-shadow .2s, border-color .2s;
}

button {
    margin-top: 25px;
    border: 1px solid transparent;
    background: linear-gradient(100deg, #087fae, #16b9d5);
    color: #031522;
    box-shadow: 0 8px 25px rgba(0, 190, 225, .2);
}

button:hover,
.link:hover {
    transform: translateY(-2px);
}

button:hover {
    background: linear-gradient(100deg, #12a6d2, #61e5f5);
    box-shadow: 0 10px 28px rgba(0, 190, 225, .3);
}

button:disabled {
    opacity: .6;
    cursor: wait;
    transform: none;
}

button.secondary,
.link.secondary {
    margin-top: 13px;
    border: 1px solid rgba(75, 211, 238, .42);
    background: rgba(29, 76, 104, .25);
    color: var(--cyan-soft);
    box-shadow: none;
}

button.secondary:hover,
.link.secondary:hover {
    background: rgba(31, 119, 151, .28);
    border-color: var(--cyan);
}

.link {
    margin-top: 12px;
    border: 1px solid rgba(147, 184, 211, .16);
    background: rgba(255, 255, 255, .035);
    color: #d8efff;
}

.link:hover {
    border-color: var(--cyan);
    background: rgba(57, 217, 242, .08);
    color: #fff;
}

#message {
    min-height: 24px;
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.8;
}

#message[data-state="error"] {
    color: #ff8f9a;
}

#message[data-state="success"] {
    color: #6ee7b7;
}

hr {
    height: 1px;
    margin: 25px 0;
    border: 0;
    background: linear-gradient(90deg, transparent, rgba(116, 192, 220, .3), transparent);
}

@media (max-width: 520px) {
    body {
        padding: 18px 13px;
    }

    main {
        padding: 29px 22px;
        border-radius: 19px;
    }

    .brand {
        margin-bottom: 22px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        transition-duration: .01ms !important;
    }
}
